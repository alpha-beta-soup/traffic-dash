{
  "name": "traffic-dash",
  "private": true,
  "version": "2.0.0",
  "description": "Traffic dashboard for New Zealand",
  "type": "module",
  "author": "Richard Law",
  "license": "MIT",
  "homepage": "https://github.com/alpha-beta-soup/traffic-dash",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,counter,client \"npm:dev:server\" \"npm:dev:counter\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:counter": "node --watch --env-file-if-exists=.env counter/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "counter": "node --env-file-if-exists=.env counter/index.js",
    "test": "node --import ./tests/support/register.mjs --test 'tests/**/*.test.js'",
    "lint": "eslint .",
    "eval:vehicles": "node scripts/vehicle-eval/evaluate.mjs",
    "eval:trends": "node scripts/vehicle-eval/trends.mjs",
    "eval:occupancy": "node scripts/vehicle-eval/occupancy.mjs",
    "eval:road": "node scripts/vehicle-eval/road.mjs",
    "eval:far": "node scripts/vehicle-eval/far.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.0",
    "@openmeteo/weather-map-layer": "^0.3.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "maplibre-gl": "^6.14.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "vite": "^6.3.5"
  }
}
