# All optional. Without them the dashboard still shows cameras and message signs.

# OpenWeatherMap API key: weather and sunrise/sunset per camera (free tier OK)
OPENWEATHERMAP_APIKEY=
# Mapbox token: congestion score per camera via Mapbox Traffic v1 tilequery (free tier OK)
MAPBOX_TOKEN=
# Base map style URLs, for the light and dark themes (default to OpenFreeMap, which needs no key)
MAP_STYLE=
MAP_STYLE_DARK=

PORT=3000
# Frames are cached on disk to animate recent history
CACHE_ENABLED=true
CACHE_MAX_AGE_HOURS=6

# Camera image refresh interval (ms); each camera picks a random interval in the range
VITE_MIN_REFRESH=10000
VITE_MAX_REFRESH=25000
