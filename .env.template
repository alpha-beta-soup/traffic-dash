# All optional. Without them the dashboard still shows cameras and message signs.

# OpenWeatherMap API key: weather and sunrise/sunset per camera, and the rain layer (free tier OK)
OPENWEATHERMAP_APIKEY=
# Mapbox token: traffic lines and congestion per camera, from Mapbox Traffic v1 tiles (free tier OK)
MAPBOX_TOKEN=
# Base map style URLs, for the light and dark themes (default to OpenFreeMap, which needs no key)
MAP_STYLE=
MAP_STYLE_DARK=

PORT=3000
# Frames are cached on disk to animate recent history
CACHE_ENABLED=true
CACHE_MAX_AGE_HOURS=6

# Camera image refresh interval (ms); each camera picks a random interval in the range. Read when
# the app is built.
VITE_MIN_REFRESH=10000
VITE_MAX_REFRESH=25000

# Vehicle counter (npm run counter): the model, medium (the default) or small, or the path to
# another (see scripts/vehicle-eval/readme.md); how long counts are kept (days); and how many
# threads it runs on (by default, one per core)
VEHICLE_MODEL=
VEHICLE_COUNTS_DAYS=7
VEHICLE_THREADS=
# Past this (MB), the counter saves its counts and exits, to be restarted (as Docker does); off if unset
VEHICLE_MAX_MEMORY_MB=

# Deploying (see readme.md): the domain Caddy gets a certificate for; and, behind a proxy, how many
# hops of X-Forwarded-For the server trusts (docker-compose.yml sets 1, for Caddy)
DOMAIN=
TRUST_PROXY=
